{
    "name": "kingdomarchitect",
    "version": "1.0.0",
    "description": "Kingdom architects is intended to be a building/management game",
    "type": "module",
    "author": "Trym Nilsen",
    "private": true,
    "license": "Kingdom Architect Source-Available License (KASAL-1.0)",
    "homepage": "https://github.com/trymnilsen/kingdomarchitect#readme",
    "scripts": {
        "build": "tsc && rollup -c",
        "build:tsc": "tsc",
        "bundle": "rollup -c",
        "serve": "node ts/tool/dev-server.ts",
        "spritepack": "tsc && node build/tool/spritepack/spritePack.js && npm run build",
        "characterpack": "tsc && node build/tool/characterpack/characterPack.js && npm run build",
        "pondpack": "node ts/tool/pondpack/pondPack.ts",
        "test": "node --test --test-reporter=dot 'ts/test/**/*.test.ts'",
        "format": "prettier --write \"ts/**/*.ts\"",
        "check-format": "prettier --check \"ts/**/*.ts\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/trymnilsen/kingdomarchitect.git"
    },
    "bugs": {
        "url": "https://github.com/trymnilsen/kingdomarchitect/issues"
    },
    "dependencies": {
        "@types/node": "^26.5.1",
        "@types/pngjs": "^6.0.5",
        "@types/ws": "^8.18.1",
        "maxrects-packer": "^2.7.3",
        "pngjs": "^7.0.0",
        "prettier": "^3.9.6",
        "rollup": "^4.63.1",
        "rollup-plugin-sourcemaps2": "^0.5.8",
        "typescript": "^7.0.2",
        "ws": "^8.21.3"
    }
}
